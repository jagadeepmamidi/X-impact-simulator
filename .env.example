APP_ENV=development
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=1
SIM_SEED=42
SIM_USERS_PER_PERSONA=40
SIM_MONTE_CARLO_RUNS=30
SIM_MAX_ROUNDS=6
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=
# Optional administrator key. Direct API callers using this key can access every owner.
SIM_API_KEY=
# Per-owner production keys. Each key can access only runs it created.
# Example: {"operator":"replace-with-a-long-random-secret"}
SIM_ACCESS_KEYS_JSON=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
TRUSTED_PROXY_CIDRS=
MAX_TEXT_CHARS=10000
MAX_IMAGES=5
MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=33554432
MAX_TOTAL_UPLOAD_BYTES=41943040
MAX_REQUEST_BYTES=46137344
UPLOAD_CHUNK_BYTES=65536
STORAGE_BACKEND=sqlite
ALLOW_SQLITE_IN_PRODUCTION=false
RUN_RETENTION_DAYS=0
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production server-side proxy target. The proxy forwards the operator-entered key; it never injects SIM_API_KEY.
BACKEND_API_URL=http://127.0.0.1:8000
# Local-development gate only; browser-visible and never a production secret.
NEXT_PUBLIC_SIM_DEV_TOKEN=
HF_TOKEN=
