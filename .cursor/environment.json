{
  "name": "X Impact Simulator",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev"
    }
  ],
  "ports": [3000, 8000]
}
